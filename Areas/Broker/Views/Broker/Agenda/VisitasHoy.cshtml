@model IEnumerable<Entregable2_VilchezGuardia_JF.Models.Visita>
@{
    ViewData["Title"] = "Visitas Hoy";
}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr>
            <th>InmuebleId</th>
            <th>Usuario</th>
            <th>Inicio</th>
            <th>Fin</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var v in Model)
    {
        <tr>
            <td>@v.InmuebleId</td>
            <td>@v.UsuarioId</td>
            <td>@v.FechaInicio</td>
            <td>@v.FechaFin</td>
            <td>@v.Estado</td>
            <td>
                <a asp-action="Confirmar" asp-route-id="@v.Id" class="btn btn-success btn-sm">Confirmar</a>
                <a asp-action="Cancelar" asp-route-id="@v.Id" class="btn btn-danger btn-sm">Cancelar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
